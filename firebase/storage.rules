rules_version = '2';

// Images live at reports/{reportId}/{index}.jpg. The size cap is the server-side
// half of the "every image < 5 MB" guarantee: the client compresses, but we never
// trust the client. There is no login in scope, so access is open; a real
// deployment would add request.auth checks here.
service firebase.storage {
  match /b/{bucket}/o {
    match /reports/{reportId}/{fileName} {
      allow read: if true;
      allow write: if request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/jpeg')
                   && fileName.matches('[0-4][.]jpg');
    }
  }
}
